# Postgres (Railway: add a Postgres plugin and copy DATABASE_URL)
DATABASE_URL=postgres://user:password@localhost:5432/traybox

# Public URL of this site (used in emails and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Lemon Squeezy checkout link for the product
NEXT_PUBLIC_CHECKOUT_URL=https://YOUR-STORE.lemonsqueezy.com/buy/YOUR-VARIANT-UUID

# Lemon Squeezy webhook (Settings -> Webhooks). Events: order_created, order_refunded
LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional: only accept orders for this product id
LEMONSQUEEZY_PRODUCT_ID=

# License signing key pair. Generate with: npm run keygen
LICENSE_PRIVATE_KEY=
# Put the printed PUBLIC key into the app (LicenseConfig.publicKey)

# Admin login. Generate the hash with: npm run hash-password -- "your password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
# Random string, 32+ chars. e.g. openssl rand -base64 48
SESSION_SECRET=

# Email (Resend). Without a key, emails are only logged to the console.
RESEND_API_KEY=
EMAIL_FROM=Traybox <licenses@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# Default number of Macs per license
DEFAULT_MAX_ACTIVATIONS=3
